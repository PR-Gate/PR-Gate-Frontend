# Local demonstration only; production must explicitly select oidc and a real gateway.
VITE_API_BASE_URL=/api
VITE_ENABLE_MOCKS=true
VITE_AUTH_MODE=demo
# Cognito: issuer is the user pool issuer, NOT the hosted UI domain.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_LOGOUT_URI=
VITE_COGNITO_LOGOUT_URL=
